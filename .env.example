# OpenAI settings are server-only. Keep the real key in Replit Secrets.
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-5.6-terra
OPENAI_INVOICE_COMPARE_MODELS=gpt-5.6-sol,gpt-5.6-luna
OPENAI_INVOICE_IMAGE_DETAIL=original
OPENAI_INVOICE_REASONING_EFFORT=low
INVOICE_OCR_REQUEST_TIMEOUT_MS=90000

# Phase 1 stays off until the isolated test database is ready.
INVOICE_OCR_ENABLED=false
INVOICE_OCR_TEST_MODE=true
INVOICE_OCR_MAX_FILE_MB=12
INVOICE_OCR_ALLOWED_CLERK_USER_IDS=
